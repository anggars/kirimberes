generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  peran    String @default("USER") // ADMIN or USER
  nama     String?

  manifests Manifest_Pengiriman[]
}

model Kru {
  id            String @id
  nama          String
  jenis_kelamin String
  alamat        String

  driverTransactions Manifest_Pengiriman[] @relation("DriverRelation")
  helperTransactions Manifest_Pengiriman[] @relation("HelperRelation")
}

model Kendaraan {
  plat_nomor     String @id
  nama_kendaraan String
  merek          String

  manifests Manifest_Pengiriman[]
}

model Manifest_Pengiriman {
  no_pengiriman     String   @id
  tanggal_transaksi DateTime

  id_supir String
  supir    Kru    @relation("DriverRelation", fields: [id_supir], references: [id])

  id_kenek String
  kenek    Kru    @relation("HelperRelation", fields: [id_kenek], references: [id])

  plat_kendaraan String
  kendaraan      Kendaraan @relation(fields: [plat_kendaraan], references: [plat_nomor])

  invoices Faktur_Pengiriman[]

  dibuat_oleh   String?
  createdByUser User?   @relation(fields: [dibuat_oleh], references: [id])

  retur_transaksi ReturTransaksi[]
}

model Faktur_Pengiriman {
  id               Int                 @id @default(autoincrement())
  no_pengiriman    String
  manifest         Manifest_Pengiriman @relation(fields: [no_pengiriman], references: [no_pengiriman], onDelete: Cascade)
  no_faktur        String
  status           String              @default("TERKIRIM") // TERKIRIM, RETURNED
  alasan_retur     String?
  kode_pelanggan   String?
  nama_pelanggan   String?
  alamat_pelanggan String?
  total_harga      Float?

  trackingHistory Riwayat_Pelacakan[]
  items           Rincian_Barang[]
}

model Rincian_Barang {
  id          Int               @id @default(autoincrement())
  id_faktur   Int
  faktur      Faktur_Pengiriman @relation(fields: [id_faktur], references: [id], onDelete: Cascade)
  no_faktur   String            @default("")
  nama_barang String
  qty         Float             @default(1)
  qty_asli    Float             @default(1)
  satuan      String            @default("PCS") // Contoh: 'CRT', 'PCS', 'LTR', 'KG', 'PACK', 'DUS'

  @@index([no_faktur])
  @@index([id_faktur])
}

model Riwayat_Pelacakan {
  id              Int               @id @default(autoincrement())
  id_faktur       Int
  faktur          Faktur_Pengiriman @relation(fields: [id_faktur], references: [id], onDelete: Cascade)
  status          String
  lokasi          String?
  deskripsi       String?
  diperbarui_oleh String
  lat             Float?
  lng             Float?
  waktu           DateTime          @default(now())
}

model ReturTransaksi {
  nomer_retur_pengiriman String   @id
  nomer_faktur           String
  nomer_piked_up         String
  tanggal_faktur_acc     DateTime
  alasan_retur           String
  jenis_retur            String   // FULL or SEBAGIAN
  created_at             DateTime @default(now())

  // Relations
  manifest Manifest_Pengiriman @relation(fields: [nomer_piked_up], references: [no_pengiriman])

  rincian RincianRetur[]
}

model RincianRetur {
  id                     Int            @id @default(autoincrement())
  nomer_retur_pengiriman String
  nomer_faktur           String
  nomer_piked_up         String
  nama_barang            String
  qty                    Float
  satuan                 String

  // Relations
  retur ReturTransaksi @relation(fields: [nomer_retur_pengiriman], references: [nomer_retur_pengiriman], onDelete: Cascade)
}
