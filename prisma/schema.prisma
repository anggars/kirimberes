generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  role     String @default("USER") // ADMIN or USER
  name     String?
}

model Crew {
  id      String @id
  name    String
  gender  String
  address String

  driverTransactions Transaction[] @relation("DriverRelation")
  helperTransactions Transaction[] @relation("HelperRelation")
}

model Vehicle {
  plate_number String @id
  vehicle_name String
  brand        String

  transactions Transaction[]
}

model Transaction {
  transaction_no   String   @id
  transaction_date DateTime

  driver_id String
  driver    Crew   @relation("DriverRelation", fields: [driver_id], references: [id])

  helper_id String
  helper    Crew   @relation("HelperRelation", fields: [helper_id], references: [id])

  vehicle_plate String
  vehicle       Vehicle @relation(fields: [vehicle_plate], references: [plate_number])

  invoices TransactionInvoice[]
}

model TransactionInvoice {
  id             Int         @id @default(autoincrement())
  transaction_no String
  transaction    Transaction @relation(fields: [transaction_no], references: [transaction_no], onDelete: Cascade)
  invoice_no     String      @unique
  status         String      @default("PENDING") // PENDING, IN_TRANSIT, DELIVERED, CANCELLED

  trackingHistory TrackingHistory[]
}

model TrackingHistory {
  id          Int      @id @default(autoincrement())
  invoice_id  Int
  invoice     TransactionInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  updated_by  String
  lat         Float?
  lng         Float?
  timestamp   DateTime @default(now())
}
