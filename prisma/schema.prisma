generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  role     String @default("USER") // ADMIN or USER
  name     String?

  manifests Manifest_Pengiriman[]
}

model Crew {
  id      String @id
  name    String
  gender  String
  address String

  driverTransactions Manifest_Pengiriman[] @relation("DriverRelation")
  helperTransactions Manifest_Pengiriman[] @relation("HelperRelation")
}

model Vehicle {
  plate_number String @id
  vehicle_name String
  brand        String

  manifests Manifest_Pengiriman[]
}

model Manifest_Pengiriman {
  no_pengiriman    String   @id
  transaction_date DateTime

  driver_id String
  driver    Crew   @relation("DriverRelation", fields: [driver_id], references: [id])

  helper_id String
  helper    Crew   @relation("HelperRelation", fields: [helper_id], references: [id])

  vehicle_plate String
  vehicle       Vehicle @relation(fields: [vehicle_plate], references: [plate_number])

  invoices TransactionInvoice[]

  created_by     String?
  createdByUser  User?    @relation(fields: [created_by], references: [id])

  retur_transaksi ReturTransaksi[]
}

model TransactionInvoice {
  id               Int         @id @default(autoincrement())
  no_pengiriman    String
  manifest         Manifest_Pengiriman @relation(fields: [no_pengiriman], references: [no_pengiriman], onDelete: Cascade)
  invoice_no       String
  status           String      @default("TERKIRIM") // TERKIRIM, RETURNED
  return_reason    String?
  customer_code    String?
  customer_name    String?
  customer_address String?
  total_amount     Float?

  trackingHistory TrackingHistory[]
  items           InvoiceItem[]
}

model InvoiceItem {
  id         Int                @id @default(autoincrement())
  invoice_id Int
  invoice    TransactionInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  invoice_no String             @default("")
  item_name    String
  qty          Float              @default(1)
  original_qty Float              @default(1)
  satuan       String             @default("PCS") // Contoh: 'CRT', 'PCS', 'LTR', 'KG', 'PACK', 'DUS'

  @@index([invoice_no])
  @@index([invoice_id])
}

model TrackingHistory {
  id          Int      @id @default(autoincrement())
  invoice_id  Int
  invoice     TransactionInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  updated_by  String
  lat         Float?
  lng         Float?
  timestamp   DateTime @default(now())
}

model ReturTransaksi {
  nomer_retur_pengiriman String   @id
  nomer_faktur           String
  nomer_piked_up         String
  tanggal_faktur_acc     DateTime
  alasan_retur           String
  jenis_retur            String   // FULL or SEBAGIAN
  created_at             DateTime @default(now())

  // Relations
  manifest Manifest_Pengiriman       @relation(fields: [nomer_piked_up], references: [no_pengiriman])

  rincian RincianRetur[]
}

model RincianRetur {
  id                     Int            @id @default(autoincrement())
  nomer_retur_pengiriman String
  nomer_faktur           String
  nomer_piked_up         String
  nama_barang            String
  qty                    Float
  satuan                 String

  // Relations
  retur ReturTransaksi @relation(fields: [nomer_retur_pengiriman], references: [nomer_retur_pengiriman], onDelete: Cascade)
}
